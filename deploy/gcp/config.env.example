# Copy to deploy/gcp/config.env and fill in. Not secret (secrets live in
# Secret Manager; setup.sh creates or asks for them), but kept out of git.

PROJECT_ID=attacked-ai-prod          # Google Cloud project id
REGION=asia-south1                   # Mumbai. Every service, the database and the buckets live here.
                                     # Must match "region" in firebase.json (setup.sh updates it).

# The address readers use. Until a custom domain is connected in Firebase
# Hosting, use the default: https://<PROJECT_ID>.web.app
SITE_URL=https://attacked-ai-prod.web.app

# Cloud SQL (PostgreSQL 17). db-custom-1-3840 = 1 vCPU / 3.75 GB, plenty for
# today's ~220 MB. SQL_HA=true keeps a standby in a second zone (about 2x cost).
SQL_INSTANCE=attacked-db
SQL_TIER=db-custom-1-3840
SQL_HA=false

# Email (Resend). Must be an address on the domain you verified in Resend.
MAIL_FROM="Attacked.ai <brief@attacked.ai>"

# Who signs people in: workos = WorkOS's hosted page (README → WorkOS);
# own = our emailed code + Google. Switching back later needs no rebuild:
#   gcloud run services update attacked-api --region=<REGION> --update-env-vars=AUTH_PROVIDER=own
AUTH_PROVIDER=workos
# The WorkOS Production environment's client ID (deploy/gcp/WORKOS.md). Not
# secret; the API key itself goes in Secret Manager (workos-api-key).
WORKOS_CLIENT_ID=client_01M4APWMDPZ0XA5DFQDWCVZWW5

# Leave empty so customers sign in with any Google account. Set to a domain
# (e.g. attacked.ai) only for a staff-only deployment. (Our own Google sign-in
# only; with WorkOS, Google is configured in the WorkOS dashboard.)
GOOGLE_ALLOWED_DOMAIN=

# Who gets the "site is down" email from Cloud Monitoring.
ALERT_EMAIL=ops@attacked.ai
