# Copy to api/.env and fill in. Never commit api/.env.

# Public keys (left empty, the API reads VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY /
# VITE_SUPABASE_PUBLISHABLE_KEY from ../.env). Either style works.
SUPABASE_URL=https://ovenyjguhkgiceddzwna.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# THE ONE SECRET. Supabase → Project Settings → API keys → Secret keys → sb_secret_…
# (or the legacy service_role JWT under "Legacy API keys"). Lets the API read
# the subscriber tables after RLS closes them to the public, and write through
# /ingest. Paste it here only — never in the repo .env, never in chat.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only if the project still signs tokens with HS256 (this one uses ES256 keys — leave empty).
SUPABASE_JWT_SECRET=

# Who may call the API from a browser
ALLOWED_ORIGINS=http://localhost:5173,https://attackedmap.vercel.app

# Where the 310 baked reports live (default: ../public/reports)
REPORTS_DIR=

# Shared secret for the sweeper's /ingest route. Generate with:  openssl rand -hex 32
INGEST_TOKEN=

# The sign-in code email, sent by the API itself (POST /auth/send-code) so the
# reader always gets a CODE regardless of the Supabase email templates. Same
# Gmail sender + app password the daily brief uses (Supabase project secrets
# GMAIL_USER / GMAIL_APP_PASSWORD / SENDER_EMAIL).
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=

# Tiers that count as subscriber
SUBSCRIBER_TIERS=enterprise,admin
