# Copy to api/.env and fill in. Never commit api/.env.

# Public (same values as the web app's VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY;
# left empty, the API reads them from ../.env)
SUPABASE_URL=https://ovenyjguhkgiceddzwna.supabase.co
SUPABASE_ANON_KEY=

# Server-only secret: Supabase → Project Settings → API → service_role.
# Lets the API read the subscriber tables after RLS closes them to anon, and
# write through /ingest. Without it the API forwards the reader's own token.
SUPABASE_SERVICE_ROLE_KEY=

# Only if the project still signs tokens with HS256 (this one uses ES256 keys — leave empty).
SUPABASE_JWT_SECRET=

# Who may call the API from a browser
ALLOWED_ORIGINS=http://localhost:5173,https://attackedmap.vercel.app

# Where the 310 baked reports live (default: ../public/reports)
REPORTS_DIR=

# Shared secret for the sweeper's /ingest route. Generate with:  openssl rand -hex 32
INGEST_TOKEN=

# Tiers that count as subscriber
SUBSCRIBER_TIERS=enterprise,admin
